{
  "spec_version": "0.1",
  "name": "ticket_triage",
  "version": "1.0.0",
  "description": "Control ticket triage workflow",
  "input_schema": {
    "type": "object",
    "required": ["ticket_id", "message"],
    "properties": {
      "ticket_id": {"type": "string"},
      "message": {"type": "string"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["ticket_id", "summary"],
    "properties": {
      "ticket_id": {"type": "string"},
      "summary": {"type": "string"}
    }
  },
  "entry": "summarize",
  "nodes": [
    {
      "id": "summarize",
      "type": "template",
      "config": {"template": "Ticket message: ${$.input.message}"}
    },
    {
      "id": "result",
      "type": "output",
      "config": {
        "value": {
          "ticket_id": "${$.input.ticket_id}",
          "summary": "${$.nodes.summarize}"
        }
      }
    }
  ],
  "edges": [{"source": "summarize", "target": "result"}]
}
